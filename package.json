  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:skeleton": "node scripts/check-skeleton-coverage.mjs",
    "prebuild:android:debug": "dotenv -e .env.local -- expo prebuild --platform android",
    "android:release:debug": "dotenv -e .env.local -- expo run:android --variant debug",
    "assemble:android:release:debug": "dotenv -e .env.local -- sh -c 'cd android && ./gradlew assembleDebug'",
    "prebuild:android:prod": "dotenv -e .env.production -- expo prebuild --platform android",
    "android:release:prod": "dotenv -e .env.production -- expo run:android --variant release",
    "assemble:android:release:prod": "dotenv -e .env.production -- sh -c 'cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a'",
    "test": "vitest run"
  },
  "private": true
