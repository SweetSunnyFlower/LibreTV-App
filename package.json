    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.19",
    "expo-video": "~56.1.3",
    "expo-web-browser": "~56.0.5",
    "lightningcss": "^1.30.1",
    "lucide-react-native": "^1.18.0",
